# Target InvenTree instance.
# Demo (resets daily): https://demo.inventree.org
# Local Docker:        http://localhost:8000
BASE_URL=https://demo.inventree.org

# Privileged user used for create/edit/delete flows
INVENTREE_USER=allaccess
INVENTREE_PASSWORD=nolimits

# Read-only user used for unauthorised / permission-negative API tests
INVENTREE_READONLY_USER=reader
INVENTREE_READONLY_PASSWORD=readonly

# No-permission user (demo dataset)
INVENTREE_NOPRIV_USER=noaccess
INVENTREE_NOPRIV_PASSWORD=youshallnotpass
